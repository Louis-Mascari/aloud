#!/usr/bin/env bash
# voice — control and query claude-voice. Used by you, by the WezTerm keys, and by
# the update-status poll (refocus).
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "$HERE/../lib/voice-lib.sh"
voice_init

# Speak a pane's recap: "<task>: <last summary, or a phrase for the state>".
# Non-consuming, works any time — the "what is this tab doing" answer.
_recap() {
  local p="$1" task last st line
  last="$(cat "$LAST_DIR/$p" 2>/dev/null)"
  if [ -n "$last" ]; then
    line="$last"                       # replay the message verbatim
  else
    task="$(cat "$TASK_DIR/$p" 2>/dev/null)"
    st="$(cat "$STATE_DIR/$p" 2>/dev/null)"
    case "$st" in
      working) line="still working";;
      input)   line="waiting for your input";;
      error)   line="hit an error and stopped";;
      ready)   line="finished";;
      *)       line="nothing to report";;
    esac
    [ -n "$task" ] && line="$task. $line"
  fi
  voice_stop                           # cut any current playback so it restarts from the top
  voice_say_sync_pane "$p" "$line"
}

case "${1:-status}" in
  auto)   echo auto > "$MODE_FILE"; echo "voice: auto — speaks in the focused pane" ;;
  wait)   echo wait > "$MODE_FILE"; echo "voice: wait — silent; press the drain key to hear a pane" ;;
  toggle)
    if [ "$(voice_mode)" = auto ]; then echo wait > "$MODE_FILE"; voice_ping "$VOICE_SOUND_WAIT"
    else echo auto > "$MODE_FILE"; voice_say "Voice on"; fi ;;
  status) echo "voice mode: $(voice_mode)  |  kokoro voice: $VOICE_KOKORO_VOICE" ;;

  # voices [prefix] — hear a sample in each Kokoro voice (filter: af am bf bm).
  voices)
    if [ -x "$KOKORO_DIR/.venv/bin/python" ] && [ -f "$KOKORO_DIR/demo-voices.py" ]; then
      "$KOKORO_DIR/.venv/bin/python" "$KOKORO_DIR/demo-voices.py" "${2:-}"
    else
      echo "Kokoro not set up. Built-in 'say' voices: run  say -v '?'"
    fi ;;

  # use <voice> — set the Kokoro voice in config.sh and preview it.
  use)
    v="${2:-}"; [ -n "$v" ] || { echo "usage: voice use <voice>  (e.g. af_heart)"; exit 2; }
    cfg="$VOICE_DIR/config.sh"; touch "$cfg"
    if grep -q '^VOICE_KOKORO_VOICE=' "$cfg"; then
      sed -i.bak "s/^VOICE_KOKORO_VOICE=.*/VOICE_KOKORO_VOICE=$v/" "$cfg" && rm -f "$cfg.bak"
    else
      printf '\nVOICE_KOKORO_VOICE=%s\n' "$v" >> "$cfg"
    fi
    echo "voice set to $v"
    [ -x "$KOKORO_SAY" ] && "$KOKORO_SAY" "This is now your voice." "$v" 1.0 ;;

  # speed <mult> — set speaking speed (1.0 = normal), both backends, and preview.
  speed)
    n="${2:-}"; [ -n "$n" ] || { echo "usage: voice speed <0.5-2.0>  (1.0 = normal)"; exit 2; }
    cfg="$VOICE_DIR/config.sh"; touch "$cfg"
    rate=$(awk "BEGIN{printf \"%d\", $n*175}")
    for kv in "VOICE_KOKORO_SPEED=$n" "VOICE_SAY_RATE=$rate"; do
      k="${kv%%=*}"
      if grep -q "^$k=" "$cfg"; then sed -i.bak "s#^$k=.*#$kv#" "$cfg" && rm -f "$cfg.bak"
      else printf '%s\n' "$kv" >> "$cfg"; fi
    done
    echo "speed $n (kokoro), $rate wpm (say)"
    [ -x "$KOKORO_SAY" ] && "$KOKORO_SAY" "This is the new speaking speed." "$VOICE_KOKORO_VOICE" "$n" ;;

  # autospeak [on|off] — on: speak on switch/finish; off: silent, press a key to hear.
  autospeak)
    cfg="$VOICE_DIR/config.sh"; touch "$cfg"
    case "${2:-toggle}" in on) new=true;; off) new=false;; *) [ "$VOICE_AUTO_SPEAK" = true ] && new=false || new=true;; esac
    if grep -q '^VOICE_AUTO_SPEAK=' "$cfg"; then sed -i.bak "s/^VOICE_AUTO_SPEAK=.*/VOICE_AUTO_SPEAK=$new/" "$cfg" && rm -f "$cfg.bak"
    else printf '\nVOICE_AUTO_SPEAK=%s\n' "$new" >> "$cfg"; fi
    [ "$new" = true ] && echo "auto-speak ON (speaks on switch/finish)" || echo "auto-speak OFF (silent; press drain/replay to hear)" ;;

  # help — one-screen cheatsheet.
  help)
    cat <<'H'
claude-voice — press a key, or run `voice <command>`

Hear it:
  Cmd+Shift+V   play a background tab's pending summary
  Cmd+Shift+R   repeat the last summary from the beginning
  Cmd+Shift+J   jump to the tab that most needs you, and read it
  Cmd+.         stop talking

Quiet it:
  Cmd+Ctrl+V           wait mode on/off — total silence, for meetings
  voice autospeak off  stop auto-reading (still pings); pull with V or R

Voice & speed:
  voice voices [af|am|bf|bm]   hear the voices (space next, p back, q quit)
  voice use <name>             pick a voice
  voice speed 1.2              1.0 = normal, higher = faster

  Cmd+Shift+/  this menu        config: ~/.claude/voice/config.sh
H
    ;;
  stop|shush) voice_stop; exit 0 ;;

  # drain [pane] — speak this pane's queued summary, else recap it. Distinct claim
  # file so it never contends with the refocus poll's rename.
  drain)
    p="${2:-${WEZTERM_PANE:-}}"; q="$QUEUE_DIR/$p"; c="$q.drain.$$"
    if [ -n "$p" ] && mv "$q" "$c" 2>/dev/null; then
      voice_clear_state "$p"; voice_say_sync_pane "$p" "$(cat "$c")"; rm -f "$c"
    else
      _recap "${p:-${WEZTERM_PANE:-}}"
    fi ;;

  # refocus <pane> — auto-speak a queued summary when you land on a pane (auto only).
  refocus)
    p="${2:-}"; [ -n "$p" ] || exit 0
    [ "$VOICE_AUTO_SPEAK" = true ] || exit 0    # silent mode: leave the ✓ for on-demand
    # you're looking at this pane now, so a "done" glyph is seen — drop it.
    [ "$(cat "$STATE_DIR/$p" 2>/dev/null)" = ready ] && voice_clear_state "$p"
    [ "$(voice_mode)" = auto ] || exit 0
    q="$QUEUE_DIR/$p"; c="$q.speaking"
    mv "$q" "$c" 2>/dev/null || exit 0
    voice_say_sync_pane "$p" "$(cat "$c")"; rm -f "$c" ;;

  # switched <pane> — you moved to a new pane: cut the pane you left off mid-speech,
  # then mark this one seen and speak its queued summary.
  switched)
    p="${2:-}"
    voice_stop
    [ -n "$p" ] || exit 0
    [ "$VOICE_AUTO_SPEAK" = true ] || exit 0    # silent mode: just stop the pane you left
    [ "$(cat "$STATE_DIR/$p" 2>/dev/null)" = ready ] && voice_clear_state "$p"
    [ "$(voice_mode)" = auto ] || exit 0
    q="$QUEUE_DIR/$p"; c="$q.speaking"
    mv "$q" "$c" 2>/dev/null || exit 0
    voice_say_sync_pane "$p" "$(cat "$c")"; rm -f "$c" ;;

  # recap [pane] — say what this tab is doing right now, on demand.
  recap) _recap "${2:-${WEZTERM_PANE:-}}" ;;

  # jump — focus the most urgent pane (error > input > ready) and recap it.
  jump)
    best=""; bestrank=0
    for f in "$STATE_DIR"/*; do
      [ -e "$f" ] || continue
      r=$(voice_rank "$(cat "$f" 2>/dev/null)")
      [ "$r" -gt "$bestrank" ] && { bestrank=$r; best="${f##*/}"; }
    done
    if [ -n "$best" ]; then
      wezterm cli activate-pane --pane-id "$best" 2>/dev/null
      _recap "$best"
    else
      voice_say_sync "Nothing needs you."
    fi ;;

  # attention — compact count of panes needing you, for the status bar / CLI.
  attention)
    e=0; i=0; r=0
    for f in "$STATE_DIR"/*; do
      [ -e "$f" ] || continue
      case "$(cat "$f" 2>/dev/null)" in error) e=$((e+1));; input) i=$((i+1));; ready) r=$((r+1));; esac
    done
    out=""   # concatenate only; bash 3.2 corrupts multibyte in ${var%...} under a UTF-8 locale
    _a() { [ -z "$out" ] && out="$1" || out="$out $1"; }
    [ "$e" -gt 0 ] && _a "✗$e"; [ "$i" -gt 0 ] && _a "⏸$i"; [ "$r" -gt 0 ] && _a "✓$r"
    printf '%s\n' "$out" ;;

  *) echo "usage: voice {help|voices|use|speed|autospeak|auto|wait|toggle|status|stop|drain|recap|jump|attention}"; exit 2 ;;
esac
