#!/usr/bin/env bash
# voice — control and query claude-voice. Used by you, by the WezTerm keys, and by
# the update-status poll (refocus).
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "$HERE/../lib/voice-lib.sh"
voice_init

# Speak a pane's recap: "<task>: <last summary, or a phrase for the state>".
# Non-consuming, works any time — the "what is this tab doing" answer.
_recap() {
  local p="$1" task last st line
  task="$(cat "$TASK_DIR/$p" 2>/dev/null)"
  last="$(cat "$LAST_DIR/$p" 2>/dev/null)"
  st="$(cat "$STATE_DIR/$p" 2>/dev/null)"
  if [ -n "$last" ]; then
    line="$last"
  else
    case "$st" in
      working) line="still working";;
      input)   line="waiting for your input";;
      error)   line="hit an error and stopped";;
      ready)   line="finished";;
      *)       line="nothing to report";;
    esac
  fi
  [ -n "$task" ] && line="$task. $line"
  voice_say_sync "$line"
}

case "${1:-status}" in
  auto)   echo auto > "$MODE_FILE"; echo "voice: auto — speaks in the focused pane" ;;
  wait)   echo wait > "$MODE_FILE"; echo "voice: wait — silent; press the drain key to hear a pane" ;;
  toggle)
    if [ "$(voice_mode)" = auto ]; then echo wait > "$MODE_FILE"; voice_ping "$VOICE_SOUND_WAIT"
    else echo auto > "$MODE_FILE"; voice_say "Voice on"; fi ;;
  status) echo "voice mode: $(voice_mode)" ;;
  stop|shush)
    killall say 2>/dev/null; killall afplay 2>/dev/null
    touch "$VOICE_DIR/kokoro/interrupt" 2>/dev/null   # signals the Kokoro daemon to stop mid-summary
    exit 0 ;;

  # drain [pane] — speak this pane's queued summary, else recap it. Distinct claim
  # file so it never contends with the refocus poll's rename.
  drain)
    p="${2:-${WEZTERM_PANE:-}}"; q="$QUEUE_DIR/$p"; c="$q.drain.$$"
    if [ -n "$p" ] && mv "$q" "$c" 2>/dev/null; then
      voice_clear_state "$p"; voice_say_sync "$(cat "$c")"; rm -f "$c"
    else
      _recap "${p:-${WEZTERM_PANE:-}}"
    fi ;;

  # refocus <pane> — auto-speak a queued summary when you land on a pane (auto only).
  refocus)
    p="${2:-}"; [ -n "$p" ] || exit 0
    # you're looking at this pane now, so a "done" glyph is seen — drop it.
    [ "$(cat "$STATE_DIR/$p" 2>/dev/null)" = ready ] && voice_clear_state "$p"
    [ "$(voice_mode)" = auto ] || exit 0
    q="$QUEUE_DIR/$p"; c="$q.speaking"
    mv "$q" "$c" 2>/dev/null || exit 0
    voice_say_sync "$(cat "$c")"; rm -f "$c" ;;

  # recap [pane] — say what this tab is doing right now, on demand.
  recap) _recap "${2:-${WEZTERM_PANE:-}}" ;;

  # jump — focus the most urgent pane (error > input > ready) and recap it.
  jump)
    best=""; bestrank=0
    for f in "$STATE_DIR"/*; do
      [ -e "$f" ] || continue
      r=$(voice_rank "$(cat "$f" 2>/dev/null)")
      [ "$r" -gt "$bestrank" ] && { bestrank=$r; best="${f##*/}"; }
    done
    if [ -n "$best" ]; then
      wezterm cli activate-pane --pane-id "$best" 2>/dev/null
      _recap "$best"
    else
      voice_say_sync "Nothing needs you."
    fi ;;

  # attention — compact count of panes needing you, for the status bar / CLI.
  attention)
    e=0; i=0; r=0
    for f in "$STATE_DIR"/*; do
      [ -e "$f" ] || continue
      case "$(cat "$f" 2>/dev/null)" in error) e=$((e+1));; input) i=$((i+1));; ready) r=$((r+1));; esac
    done
    out=""   # concatenate only; bash 3.2 corrupts multibyte in ${var%...} under a UTF-8 locale
    _a() { [ -z "$out" ] && out="$1" || out="$out $1"; }
    [ "$e" -gt 0 ] && _a "✗$e"; [ "$i" -gt 0 ] && _a "⏸$i"; [ "$r" -gt 0 ] && _a "✓$r"
    printf '%s\n' "$out" ;;

  *) echo "usage: voice {auto|wait|toggle|status|stop|drain|recap|jump|attention|refocus <pane>}"; exit 2 ;;
esac
